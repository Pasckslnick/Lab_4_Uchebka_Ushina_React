BEGIN;

DROP TABLE IF EXISTS password_reset_tokens CASCADE;
DROP TABLE IF EXISTS reviews CASCADE;
DROP TABLE IF EXISTS order_items CASCADE;
DROP TABLE IF EXISTS cart_items CASCADE;
DROP TABLE IF EXISTS orders CASCADE;
DROP TABLE IF EXISTS carts CASCADE;
DROP TABLE IF EXISTS services CASCADE;
DROP TABLE IF EXISTS categories CASCADE;
DROP TABLE IF EXISTS order_statuses CASCADE;
DROP TABLE IF EXISTS users CASCADE;
DROP TABLE IF EXISTS roles CASCADE;

CREATE TABLE roles (
    id BIGINT GENERATED ALWAYS AS IDENTITY PRIMARY KEY,
    name VARCHAR(30) NOT NULL UNIQUE,
    description VARCHAR(255)
);

CREATE TABLE users (
    id BIGINT GENERATED ALWAYS AS IDENTITY PRIMARY KEY,
    role_id BIGINT NOT NULL REFERENCES roles(id),
    full_name VARCHAR(150) NOT NULL,
    email VARCHAR(255) NOT NULL UNIQUE,
    password_hash TEXT NOT NULL,
    phone VARCHAR(20) NOT NULL,
    default_address TEXT,
    is_active BOOLEAN NOT NULL DEFAULT TRUE,
    created_at TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP,
    updated_at TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP,

    CONSTRAINT chk_user_name
        CHECK (LENGTH(TRIM(full_name)) >= 2),

    CONSTRAINT chk_user_email
        CHECK (email ~* '^[A-Z0-9._%+-]+@[A-Z0-9.-]+\.[A-Z]{2,}$'),

    CONSTRAINT chk_user_phone
        CHECK (phone ~ '^\+?[0-9 ()-]{7,20}$')
);

CREATE TABLE categories (
    id BIGINT GENERATED ALWAYS AS IDENTITY PRIMARY KEY,
    name VARCHAR(100) NOT NULL UNIQUE,
    description TEXT,
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP
);

CREATE TABLE services (
    id BIGINT GENERATED ALWAYS AS IDENTITY PRIMARY KEY,
    category_id BIGINT NOT NULL REFERENCES categories(id),
    name VARCHAR(150) NOT NULL,
    description TEXT NOT NULL,
    duration_minutes INTEGER NOT NULL,
    price NUMERIC(12, 2) NOT NULL,
    is_available BOOLEAN NOT NULL DEFAULT TRUE,
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    updated_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,

    CONSTRAINT chk_service_duration
        CHECK (duration_minutes > 0),

    CONSTRAINT chk_service_price
        CHECK (price >= 0),

    CONSTRAINT uq_service_category_name
        UNIQUE (category_id, name)
);

CREATE TABLE carts (
    id BIGINT GENERATED ALWAYS AS IDENTITY PRIMARY KEY,
    user_id BIGINT NOT NULL UNIQUE REFERENCES users(id)
        ON DELETE CASCADE,
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    updated_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP
);

CREATE TABLE cart_items (
    id BIGINT GENERATED ALWAYS AS IDENTITY PRIMARY KEY,
    cart_id BIGINT NOT NULL REFERENCES carts(id)
        ON DELETE CASCADE,
    service_id BIGINT NOT NULL REFERENCES services(id),
    quantity INTEGER NOT NULL DEFAULT 1,
    added_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,

    CONSTRAINT chk_cart_quantity CHECK (quantity > 0),
    CONSTRAINT uq_cart_service UNIQUE (cart_id, service_id)
);

CREATE TABLE order_statuses (
    id BIGINT GENERATED ALWAYS AS IDENTITY PRIMARY KEY,
    name VARCHAR(40) NOT NULL UNIQUE,
    description VARCHAR(255)
);

CREATE TABLE orders (
    id BIGINT GENERATED ALWAYS AS IDENTITY PRIMARY KEY,
    user_id BIGINT NOT NULL REFERENCES users(id),
    status_id BIGINT NOT NULL REFERENCES order_statuses(id),
    delivery_address TEXT NOT NULL,
    delivery_date DATE NOT NULL,
    total_amount NUMERIC(12, 2) NOT NULL DEFAULT 0,
    created_at TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP,
    updated_at TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP,

    CONSTRAINT chk_order_amount CHECK (total_amount >= 0),
    CONSTRAINT chk_delivery_address
        CHECK (LENGTH(TRIM(delivery_address)) >= 5),
    CONSTRAINT chk_delivery_date
        CHECK (delivery_date >= CURRENT_DATE)
);

CREATE TABLE order_items (
    id BIGINT GENERATED ALWAYS AS IDENTITY PRIMARY KEY,
    order_id BIGINT NOT NULL REFERENCES orders(id)
        ON DELETE CASCADE,
    service_id BIGINT REFERENCES services(id)
        ON DELETE SET NULL,
    service_name VARCHAR(150) NOT NULL,
    price_at_order NUMERIC(12, 2) NOT NULL,
    quantity INTEGER NOT NULL,
    duration_minutes INTEGER NOT NULL,

    CONSTRAINT chk_order_item_price
        CHECK (price_at_order >= 0),
    CONSTRAINT chk_order_item_quantity
        CHECK (quantity > 0),
    CONSTRAINT chk_order_item_duration
        CHECK (duration_minutes > 0)
);

CREATE TABLE reviews (
    id BIGINT GENERATED ALWAYS AS IDENTITY PRIMARY KEY,
    user_id BIGINT NOT NULL REFERENCES users(id)
        ON DELETE CASCADE,
    service_id BIGINT NOT NULL REFERENCES services(id)
        ON DELETE CASCADE,
    rating SMALLINT NOT NULL,
    comment TEXT NOT NULL,
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    updated_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,

    CONSTRAINT chk_review_rating
        CHECK (rating BETWEEN 1 AND 5),

    CONSTRAINT chk_review_comment
        CHECK (LENGTH(TRIM(comment)) BETWEEN 2 AND 2000),

    CONSTRAINT uq_user_service_review
        UNIQUE (user_id, service_id)
);

CREATE TABLE password_reset_tokens (
    id BIGINT GENERATED ALWAYS AS IDENTITY PRIMARY KEY,
    user_id BIGINT NOT NULL REFERENCES users(id)
        ON DELETE CASCADE,
    token_hash TEXT NOT NULL UNIQUE,
    expires_at TIMESTAMP NOT NULL,
    used_at TIMESTAMP,
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP
);

CREATE INDEX idx_users_role ON users(role_id);
CREATE INDEX idx_services_category ON services(category_id);
CREATE INDEX idx_services_price ON services(price);
CREATE INDEX idx_cart_items_cart ON cart_items(cart_id);
CREATE INDEX idx_orders_user ON orders(user_id);
CREATE INDEX idx_orders_status ON orders(status_id);
CREATE INDEX idx_orders_date ON orders(delivery_date);
CREATE INDEX idx_order_items_order ON order_items(order_id);
CREATE INDEX idx_reviews_service ON reviews(service_id);
CREATE INDEX idx_reviews_user ON reviews(user_id);
CREATE INDEX idx_reset_tokens_user ON password_reset_tokens(user_id);

INSERT INTO roles (name, description) VALUES
('USER', 'Обычный пользователь'),
('ADMIN', 'Администратор системы');

INSERT INTO order_statuses (name, description) VALUES
('NEW', 'Новый заказ'),
('CONFIRMED', 'Заказ подтвержден'),
('IN_PROGRESS', 'Заказ выполняется'),
('COMPLETED', 'Заказ выполнен'),
('CANCELLED', 'Заказ отменен');

INSERT INTO categories (name, description) VALUES
('IT-услуги', 'Компьютерные и технические услуги'),
('Обслуживание', 'Услуги по обслуживанию'),
('Консультации', 'Профессиональные консультации'),
('Дизайн', 'Услуги дизайна');

INSERT INTO services (
    category_id, name, description,
    duration_minutes, price
)
SELECT
    c.id, s.name, s.description,
    s.duration_minutes, s.price
FROM (
    VALUES
    ('IT-услуги', 'Настройка компьютера',
     'Диагностика и настройка компьютера', 60, 1500.00::NUMERIC),
    ('IT-услуги', 'Установка программ',
     'Установка и настройка программного обеспечения', 45, 1000.00::NUMERIC),
    ('Обслуживание', 'Чистка оборудования',
     'Профилактическое обслуживание оборудования', 90, 2000.00::NUMERIC),
    ('Консультации', 'IT-консультация',
     'Консультация по техническим вопросам', 30, 800.00::NUMERIC),
    ('Дизайн', 'Создание макета',
     'Разработка графического макета', 120, 3500.00::NUMERIC)
) AS s(category_name, name, description, duration_minutes, price)
JOIN categories c ON c.name = s.category_name;

COMMIT;
